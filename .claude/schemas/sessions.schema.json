{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/agency-microsoft/playground-main/MAD/schemas/sessions.schema.json",
  "title": ".sessions.json",
  "description": "Per-session membership registry. Lives at ~/claude-data/.sessions.json. Tracks which channels this session has joined.",
  "type": "object",
  "required": ["session_id", "memberships"],
  "additionalProperties": false,
  "properties": {
    "session_id": { "type": "string" },
    "started_utc": { "type": "string", "format": "date-time" },
    "memberships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["channel", "alias", "joined_utc"],
        "properties": {
          "channel": { "type": "string" },
          "alias": { "type": "string" },
          "joined_utc": { "type": "string", "format": "date-time" },
          "cron_task_id": {
            "type": "string",
            "description": "CronCreate task_id for the poller; used by /council-leave for teardown."
          }
        }
      }
    }
  }
}
